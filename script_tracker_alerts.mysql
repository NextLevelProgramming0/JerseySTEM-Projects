{"files":[{"id":"7304fc2d-f10d-4796-b76f-4b78d8b9155a","name":"appsscript","type":"json","source":"{\n  \"timeZone\": \"America/New_York\",\n  \"dependencies\": {\n  },\n  \"exceptionLogging\": \"STACKDRIVER\",\n  \"runtimeVersion\": \"V8\"\n}"},{"id":"a1e23109-8095-472b-bf1d-2e623c68005d","name":"CheckScriptTracker","type":"server_js","source":"function runcheckThreeDaysNotRunning(e) {\n  Runner.run(\n    \"check for mysql scripts tht haven\u0027t run in three days in Team_TECH_BPA.script_tracker\",\n    checkThreeDaysNotRunning,\n    e\n  );\n}\n\nfunction runcheckRunScriptsInactive(e) {\n  Runner.run(\n    \"check and report what mysql scripts have not run since yesterday in Team_TECH_BPA.script_tracker\",\n    checkRunScriptsInactive,\n    e\n  );\n}\n\n\nfunction checkThreeDaysNotRunning() {\n  const table \u003d \"Team_TECH_BPA.script_tracker\";\n  const schema \u003d \"Team_TECH_BPA\";\n  const slackChannel \u003d \"automation-errors\";\n\n  const connection \u003d Database.getReadOnlySQLConnection(schema);\n\n  try {\n    const inactiveScriptResults \u003d Database.bulkRead(\n      connection,\n      `\n        SELECT\n          name,\n          function_name,\n          last_run,\n          last_success,\n          message,\n          url,\n          is_active,\n          inactive_date\n        FROM ${table}\n        WHERE last_success \u003c DATE_SUB(NOW(), INTERVAL 3 DAY)\n          AND is_active \u003d TRUE\n      `,\n      [\n        \"name\",\n        \"function_name\",\n        \"last_run\",\n        \"last_success\",\n        \"message\",\n        \"url\",\n        \"is_active\",\n        \"inactive_date\"\n      ]\n    );\n\n    const threeDaysNotRunning \u003d new Map();\n    let count \u003d 0;\n\n    for (const inactiveScript of inactiveScriptResults) {\n      count++;\n\n      const functionName \u003d\n        `${inactiveScript.name}.${inactiveScript.function_name}`;\n\n      Logger.log(\n        `❌ Three Days Not Running: ${functionName}`\n      );\n\n      let scriptsMap \u003d\n        threeDaysNotRunning.get(slackChannel);\n\n      if (!scriptsMap) {\n        scriptsMap \u003d new Map();\n\n        threeDaysNotRunning.set(\n          slackChannel,\n          scriptsMap\n        );\n      }\n\n      scriptsMap.set(\n        functionName,\n        {\n          message: inactiveScript.message,\n          lastRun: inactiveScript.last_run,\n          lastSuccess: inactiveScript.last_success,\n          url: inactiveScript.url\n        }\n      );\n    }\n\n\n    let notificationCount \u003d 0;\n\n    for (const [channel, scriptsMap] of threeDaysNotRunning) {\n      if (channel \u003d\u003d\u003d \"automation-errors\") {\n        try {\n          const scriptLinks \u003d\n            Array.from(scriptsMap.entries())\n              .map(\n                ([functionName, scriptInfo]) \u003d\u003e {\n                  if (scriptInfo.url) {\n                    return (\n                      `\u003c${scriptInfo.url}|${functionName}\u003e` +\n                      ` | Last success: ${scriptInfo.lastSuccess}`\n                    );\n                  }\n\n                  return (\n                    `${functionName}` +\n                    ` | Last success: ${scriptInfo.lastSuccess}` +\n                    ` | URL unavailable`\n                  );\n                }\n              )\n              .join(\"\\n\");\n\n\n          const slackMessage \u003d\n            `❌ There are ${scriptsMap.size} MySQL scripts ` +\n            `that have not run successfully for 3 or more days. ` +\n            `Please review them and mark them inactive if they ` +\n            `no longer exist:\\n\\n` +\n            scriptLinks;\n\n\n          if (Test.isTest()) {\n            Logger.log(\n              `Post to ${channel}:\\n${slackMessage}`\n            );\n          } else {\n            Slack.postMessageToChannel(\n              channel,\n              slackMessage\n            );\n          }\n\n          notificationCount +\u003d 1;\n\n        } catch (e) {\n          Logger.log(\n            `❌ Error sending report to slack channel ` +\n            `${channel}: ${e.message}`\n          );\n        }\n      } else {\n        Logger.log(\n          `❌ Found ${scriptsMap.size} MySQL scripts ` +\n          `without a slack channel to send to: ` +\n          `${Array.from(scriptsMap.keys()).join(\", \")}`\n        );\n      }\n\n      Utilities.sleep(1100);\n    }\n\n\n    if (notificationCount \u003e 0) {\n      Logger.log(\n        `Sent ${notificationCount} notifications to ${slackChannel}`\n      );\n    }\n\n\n    return (\n      `Found ${count} active scripts that have not ` +\n      `run successfully for 3 or more days`\n    );\n\n  } finally {\n    connection.close();\n  }\n}\n\n\nfunction checkRunScriptsInactive() {\n  const table \u003d \"Team_TECH_BPA.script_tracker\";\n  const schema \u003d \"Team_TECH_BPA\";\n  const slackChannel \u003d \"automation-errors\";\n\n  const connection \u003d Database.getReadOnlySQLConnection(schema);\n\n  try {\n    const query \u003d `\n      SELECT\n        name,\n        function_name,\n        last_run,\n        last_success,\n        message,\n        url,\n        is_active,\n        inactive_date\n      FROM ${table}\n      WHERE DATE(last_success) \u003d CURDATE() - INTERVAL 1 DAY\n        AND is_active \u003d TRUE\n    `;\n\n\n    const inactiveScriptResults \u003d Database.bulkRead(\n      connection,\n      query,\n      [\n        \"name\",\n        \"function_name\",\n        \"last_run\",\n        \"last_success\",\n        \"message\",\n        \"url\",\n        \"is_active\",\n        \"inactive_date\"\n      ]\n    );\n\n\n    const oneDayNotRunning \u003d new Map();\n    let count \u003d 0;\n\n\n    for (const inactiveScript of inactiveScriptResults) {\n      count++;\n\n      const functionName \u003d\n        `${inactiveScript.name}.${inactiveScript.function_name}`;\n\n      Logger.log(\n        `❌ Not Running Since Yesterday: ${functionName}`\n      );\n\n\n      let scriptsMap \u003d\n        oneDayNotRunning.get(slackChannel);\n\n      if (!scriptsMap) {\n        scriptsMap \u003d new Map();\n\n        oneDayNotRunning.set(\n          slackChannel,\n          scriptsMap\n        );\n      }\n\n\n      scriptsMap.set(\n        functionName,\n        {\n          message: inactiveScript.message,\n          lastRun: inactiveScript.last_run,\n          lastSuccess: inactiveScript.last_success,\n          url: inactiveScript.url\n        }\n      );\n    }\n\n\n    let notificationCount \u003d 0;\n\n\n    for (const [channel, scriptsMap] of oneDayNotRunning) {\n      if (channel \u003d\u003d\u003d \"automation-errors\") {\n        try {\n          const scriptLinks \u003d\n            Array.from(scriptsMap.entries())\n              .map(\n                ([functionName, scriptInfo]) \u003d\u003e {\n                  if (scriptInfo.url) {\n                    return (\n                      `\u003c${scriptInfo.url}|${functionName}\u003e` +\n                      ` | Last success: ${scriptInfo.lastSuccess}`\n                    );\n                  }\n\n                  return (\n                    `${functionName}` +\n                    ` | Last success: ${scriptInfo.lastSuccess}` +\n                    ` | URL unavailable`\n                  );\n                }\n              )\n              .join(\"\\n\");\n\n\n          const slackMessage \u003d\n            `❌ There are ${scriptsMap.size} MySQL scripts ` +\n            `that ran yesterday but have not run successfully today. ` +\n            `Please review them:\\n\\n` +\n            scriptLinks;\n\n\n          if (Test.isTest()) {\n            Logger.log(\n              `Post to ${channel}:\\n${slackMessage}`\n            );\n          } else {\n            Slack.postMessageToChannel(\n              channel,\n              slackMessage\n            );\n          }\n\n\n          notificationCount +\u003d 1;\n\n        } catch (e) {\n          Logger.log(\n            `❌ Error sending report to Slack channel ` +\n            `${channel}: ${e.message}`\n          );\n        }\n      } else {\n        Logger.log(\n          `❌ Found ${scriptsMap.size} MySQL scripts ` +\n          `without a Slack channel to send to: ` +\n          `${Array.from(scriptsMap.keys()).join(\", \")}`\n        );\n      }\n\n\n      Utilities.sleep(1100);\n    }\n\n\n    if (notificationCount \u003e 0) {\n      Logger.log(\n        `Sent ${notificationCount} notifications to ${slackChannel}`\n      );\n    }\n\n\n    return (\n      `Found ${count} active scripts that ran yesterday ` +\n      `but have not run successfully today`\n    );\n\n  } finally {\n    connection.close();\n  }\n}\n\n\nfunction test() {\n  Test.setForceTest(true);\n\n  try {\n    Logger.log(\n      checkThreeDaysNotRunning()\n    );\n\n    Logger.log(\n      checkRunScriptsInactive()\n    );\n\n  } finally {\n    Test.setForceTest(false);\n  }\n}"}]}